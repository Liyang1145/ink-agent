  "canvas_solid": {
   "description": "画立体几何直观图（斜二测画法）：正方体/长方体/棱柱/棱锥/棱台/圆柱/圆锥/球。按课本习惯自动命名（正方体 ABCD-A1B1C1D1，四棱锥 P-ABCD，三棱柱 ABC-A1B1C1），看不见的棱自动画成虚线；你加的连线按是否在可见面上自动选实线/虚线。可加中点、棱上的点、面的中心，可给截面涂色。只传需要的字段。圆柱/圆锥/球自动标出顶点 P、底面圆心 O（圆柱上底 O1），可用 apex_name/center_name 改名；旋转体不支持 points/segments。",
   "parameters": {
    "type": "object",
    "properties": {
     "type": {
      "type": "string",
      "enum": [
       "cube",
       "cuboid",
       "prism",
       "pyramid",
       "frustum",
       "cylinder",
       "cone",
       "sphere"
      ]
     },
     "n": {
      "type": "integer",
      "description": "棱柱/棱锥/棱台的底面边数（棱锥默认 4，棱柱默认 3）"
     },
     "size": {
      "type": "object",
      "description": "长方体棱长 {\"a\":4,\"b\":3,\"c\":2}（长、宽、高）"
     },
     "edge": {
      "description": "正方体棱长（只影响比例，通常不用给）"
     },
     "h": {
      "description": "棱柱/棱锥/圆柱/圆锥的高（相对底面外接圆半径 r，默认 r=2,h=4）"
     },
     "r": {},
     "ratio": {
      "description": "棱台上下底比例，默认 0.5"
     },
     "apex_over": {
      "type": "string",
      "description": "棱锥顶点在哪个底面顶点正上方（如 \"A\"，表示 PA⊥底面）；默认在底面中心上方"
     },
     "apex_name": {
      "type": "string"
     },
     "names": {
      "description": "自定义全部顶点名（按默认顺序：底面逆时针、再顶面/顶点），如 \"A B C D A1 B1 C1 D1\""
     },
     "points": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "mid": {
         "type": "string",
         "description": "棱或线段的中点，如 \"BB1\""
        },
        "on": {
         "type": "string"
        },
        "t": {},
        "center": {
         "type": "string",
         "description": "面的中心，如 \"ABCD\""
        }
       },
       "required": [
        "name"
       ]
      },
      "description": "附加点"
     },
     "segments": {
      "type": "array",
      "items": {},
      "description": "连线，如 [\"A1C\",\"BD\"]；可写 {\"of\":\"AC1\",\"dashed\":false} 强制实线"
     },
     "faces": {
      "type": "array",
      "items": {},
      "description": "涂色的面/截面，如 [\"ACC1A1\"]"
     },
     "labels": {
      "type": "boolean",
      "description": "是否标顶点名，默认 true"
     },
     "page": {
      "type": "integer",
      "description": "页码，从 1 开始；省略表示当前页"
     },
     "width": {
      "type": "number",
      "description": "可选：页面上的宽度（页面像素），默认约 0.4 个页宽"
     },
     "replace": {
      "type": "string",
      "description": "可选：要原位替换的 AI 对象 id（修正已画的图时用）"
     },
     "center_name": {
      "type": "string",
      "description": "旋转体底面圆心/球心的名字，默认 O"
     }
    },
    "required": [
     "type"
    ]
   }
  },
  "canvas_annotate": {
   "description": "批改：在用户手写内容上直接叠加红色批改标记（打勾、打叉、圈出、框出、下划线、波浪线、箭头、批注文字）。坐标都是页面坐标：先用 view_page(grid=true) 看清手写内容在哪里，再一次性传所有标记。批注文字要短（一句话），详细讲解写在回复里或用 canvas_write_latex。",
   "parameters": {
    "type": "object",
    "properties": {
     "marks": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "check",
          "cross",
          "circle",
          "box",
          "underline",
          "wavy",
          "arrow",
          "text"
         ]
        },
        "x": {
         "type": "number",
         "description": "check/cross: 中心；circle/box/underline/wavy: 区域左上角（underline/wavy 的 y 是该行底部）；text: 文字左下角"
        },
        "y": {
         "type": "number"
        },
        "w": {
         "type": "number",
         "description": "区域宽"
        },
        "h": {
         "type": "number",
         "description": "区域高"
        },
        "size": {
         "type": "number",
         "description": "勾叉大小或文字字号（页面像素），默认 40 / 30"
        },
        "text": {
         "type": "string"
        },
        "from": {
         "type": "array",
         "items": {
          "type": "number"
         }
        },
        "to": {
         "type": "array",
         "items": {
          "type": "number"
         }
        },
        "color": {
         "type": "string",
         "description": "默认红色"
        }
       },
       "required": [
        "type"
       ]
      }
     },
     "page": {
      "type": "integer",
      "description": "页码，从 1 开始；省略表示当前页"
     }
    },
    "required": [
     "marks"
    ]
   }
  }
 }
}