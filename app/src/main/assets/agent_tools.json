          "center"
         ]
        },
        "of": {
         "type": "string"
        },
        "center": {
         "type": "string"
        },
        "through": {
         "type": "string"
        },
        "r": {},
        "color": {
         "type": "string"
        },
        "dashed": {
         "type": "boolean"
        }
       }
      },
      "description": "圆：{\"type\":\"circumcircle\",\"of\":\"ABC\"}、{\"type\":\"incircle\",\"of\":\"ABC\"}、{\"center\":\"O\",\"through\":\"A\"} 或 {\"center\":\"O\",\"r\":2}"
