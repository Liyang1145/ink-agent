      "description": "页码，从 1 开始；省略表示当前页"
     }
    },
    "required": []
   }
  },
  "canvas_geometry": {
   "description": "画平面几何图（三角形、四边形、圆及其作图）。你只给关键点的坐标（数学坐标，y 向上，取方便的数即可，比如 A(0,0) B(6,0) C(1.5,4)），其余由系统精确计算：中点、垂足、交点、外心/内心/重心/垂心、对称点、旋转点、外接圆/内切圆，并自动画直角标记、角弧、等长记号，点名自动放在图形外侧不重叠。点名可带下标数字（A1 显示为 A₁）。只传需要的字段。",
   "parameters": {
    "type": "object",
    "properties": {
     "points": {
      "type": "object",
      "description": "基本点坐标，如 {\"A\":[0,0],\"B\":[6,0],\"C\":[1.5,4]}；坐标可写表达式字符串如 \"sqrt(3)\"",
      "additionalProperties": {
       "type": "array",
       "items": {}
      }
     },
     "derived": {
      "type": "array",
      "description": "按顺序计算的派生点",
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string",
         "enum": [
          "midpoint",
          "foot",
          "on",
          "intersection",
          "circumcenter",
          "incenter",
          "centroid",
          "orthocenter",
          "reflect",
          "rotate"
         ]
        },
        "of": {
         "type": "string",
         "description": "midpoint/on: 线段如 \"BC\"；circumcenter 等: 三角形如 \"ABC\""
        },
        "from": {
         "type": "string",
         "description": "foot: 从哪个点作垂线；reflect/rotate: 被变换的点"
        },
        "to": {
         "type": "string",
         "description": "foot: 垂足所在直线，如 \"BC\""
        },
        "t": {
         "description": "on: 比例，0 在起点 1 在终点"
        },
        "lines": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "description": "intersection: 两条直线，如 [\"AD\",\"BE\"]"
        },
        "over": {
         "type": "string",
         "description": "reflect: 关于直线 \"AB\" 或关于点 \"O\" 对称"
        },
        "center": {
         "type": "string"
        },
        "angle": {
         "description": "rotate: 逆时针角度（度）"
        }
       },
       "required": [
        "name",
        "type"
       ]
      }
     },
     "polygons": {
      "type": "array",
