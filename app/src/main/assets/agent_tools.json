     },
     "dashed": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "辅助虚线，如 [\"CH\"]"
     },
     "lines": {
      "type": "array",
      "items": {},
      "description": "向两端延长的直线，如 [\"AB\"]"
     },
     "circles": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "circumcircle",
